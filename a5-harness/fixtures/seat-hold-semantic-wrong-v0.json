  "unit_tests": [
    {
      "candidate_id": "UT-R1",
      "kind": "unit",
      "requirement_ids": ["R1"],
      "name": "available_seat_hold_succeeds",
      "setup": ["좌석 상태는 AVAILABLE이다."],
      "action": "해당 좌석에 HOLD를 요청한다.",
      "expected": ["HOLD 요청이 성공한다."],
      "boundary_conditions": []
    },
    {
      "candidate_id": "UT-R2",
      "kind": "unit",
      "requirement_ids": ["R2"],
      "name": "active_hold_rehold_is_rejected",
      "setup": ["좌석 상태는 HELD이고 now < expiresAt이다."],
      "action": "해당 좌석에 다시 HOLD를 요청한다.",
      "expected": ["재-HOLD 요청이 거절된다."],
      "boundary_conditions": [
        {"condition": "now < expiresAt", "expected": "existing HOLD is active"}
      ]
    },
    {
      "candidate_id": "UT-R3",
      "kind": "unit",
      "requirement_ids": ["R3"],
      "name": "expired_hold_can_be_reheld",
      "setup": ["좌석 상태는 HELD이고 기존 HOLD가 만료되었다."],
      "action": "해당 좌석에 다시 HOLD를 요청한다.",
      "expected": ["재-HOLD가 허용된다."],
      "boundary_conditions": []
    },
    {
      "candidate_id": "UT-R4-WRONG",
      "kind": "unit",
      "requirement_ids": ["R4"],
      "name": "exact_expiration_is_still_active_wrong",
      "setup": ["좌석 상태는 HELD이고 now == expiresAt이다."],
      "action": "해당 좌석에 다시 HOLD를 요청한다.",
      "expected": ["기존 HOLD는 아직 active이므로 재-HOLD 요청이 거절된다."],
      "boundary_conditions": [
        {"condition": "now == expiresAt", "expected": "existing HOLD is still active"}
      ]
    }
  ],
  "gherkin_scenarios": [
    {
      "candidate_id": "GH-R1",
      "kind": "gherkin",
      "requirement_ids": ["R1"],
