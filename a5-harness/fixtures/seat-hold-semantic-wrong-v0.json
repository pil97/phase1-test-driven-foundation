      "when": ["사용자가 해당 좌석에 HOLD를 요청한다."],
      "then": ["HOLD 요청이 성공한다."],
      "boundary_conditions": []
    },
    {
      "candidate_id": "GH-R2",
      "kind": "gherkin",
      "requirement_ids": ["R2"],
      "name": "유효한 HOLD 재요청 거절",
      "given": ["좌석이 HELD 상태이고 now < expiresAt이다."],
      "when": ["사용자가 해당 좌석에 다시 HOLD를 요청한다."],
      "then": ["재-HOLD 요청이 거절된다."],
      "boundary_conditions": [
        {"condition": "now < expiresAt", "expected": "existing HOLD is active"}
      ]
    },
    {
      "candidate_id": "GH-R3",
      "kind": "gherkin",
