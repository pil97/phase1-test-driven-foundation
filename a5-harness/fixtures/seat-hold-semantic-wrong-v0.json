      "name": "만료된 HOLD 재요청 허용",
      "given": ["좌석이 HELD 상태이고 기존 HOLD가 만료되었다."],
      "when": ["사용자가 해당 좌석에 다시 HOLD를 요청한다."],
      "then": ["재-HOLD가 허용된다."],
      "boundary_conditions": []
    },
    {
      "candidate_id": "GH-R4-WRONG",
      "kind": "gherkin",
      "requirement_ids": ["R4"],
      "name": "정확한 만료 시각을 active로 취급하는 잘못된 시나리오",
      "given": ["좌석이 HELD 상태이고 now == expiresAt이다."],
      "when": ["사용자가 해당 좌석에 다시 HOLD를 요청한다."],
      "then": ["기존 HOLD는 아직 active이므로 재-HOLD 요청이 거절된다."],
      "boundary_conditions": [
