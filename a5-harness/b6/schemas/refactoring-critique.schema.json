{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "refactoring-critique.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "review_id",
    "issues"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "review_id": {
      "type": "string",
      "minLength": 1
    },
    "issues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/issue"
      }
    }
  },
  "$defs": {
    "nonEmptyUniqueStringArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "uniqueStringArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidenceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "reference"
      ],
      "properties": {
        "source": {
          "enum": [
            "actual_code_evidence",
            "gen_proposal"
          ]
        },
        "reference": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "issue",
        "evidence_references",
        "risk",
        "decision",
        "reason",
        "related_diagnosis_ids",
        "related_change_ids"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "issue": {
          "type": "string",
          "minLength": 1
        },
        "evidence_references": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidenceReference"
          }
        },
        "risk": {
          "type": "string",
          "minLength": 1
        },
        "decision": {
          "enum": [
            "REJECT",
            "REVISE"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "related_diagnosis_ids": {
          "$ref": "#/$defs/uniqueStringArray"
        },
        "related_change_ids": {
          "$ref": "#/$defs/uniqueStringArray"
        }
      }
    }
  }
}
