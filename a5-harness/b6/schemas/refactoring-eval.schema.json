{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "refactoring-eval.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evaluation_id",
    "criteria",
    "evidence_sufficiency"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "evaluation_id": {
      "type": "string",
      "minLength": 1
    },
    "criteria": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "DIAGNOSIS_ACCURACY",
        "CHANGE_MINIMALITY",
        "BEHAVIOR_PRESERVATION_RISK",
        "TESTABILITY_IMPROVEMENT"
      ],
      "properties": {
        "DIAGNOSIS_ACCURACY": {
          "$ref": "#/$defs/numericCriterion"
        },
        "CHANGE_MINIMALITY": {
          "$ref": "#/$defs/numericCriterion"
        },
        "BEHAVIOR_PRESERVATION_RISK": {
          "$ref": "#/$defs/numericCriterion"
        },
        "TESTABILITY_IMPROVEMENT": {
          "$ref": "#/$defs/numericCriterion"
        }
      }
    },
    "evidence_sufficiency": {
      "$ref": "#/$defs/evidenceSufficiency"
    }
  },
  "$defs": {
    "nonEmptyEvidenceReferences": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/evidenceReference"
      }
    },
    "evidenceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "reference"
      ],
      "properties": {
        "source": {
          "type": "string",
          "enum": [
            "actual_code_evidence",
            "gen_proposal",
            "preserved_behavior",
            "allowed_scope",
            "forbidden_scope"
          ]
        },
        "reference": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "numericCriterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "score",
        "rationale",
        "evidence_references"
      ],
      "properties": {
        "score": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "evidence_references": {
          "$ref": "#/$defs/nonEmptyEvidenceReferences"
        }
      }
    },
    "evidenceSufficiency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "rationale",
        "evidence_references"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "SUFFICIENT",
            "INSUFFICIENT"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "evidence_references": {
          "$ref": "#/$defs/nonEmptyEvidenceReferences"
        }
      }
    }
  }
}
