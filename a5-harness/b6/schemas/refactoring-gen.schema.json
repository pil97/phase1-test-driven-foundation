{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "refactoring-gen.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generation_id",
    "diagnoses",
    "proposed_changes",
    "affected_scope",
    "risks",
    "validation_plan"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "generation_id": {
      "type": "string",
      "minLength": 1
    },
    "diagnoses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/diagnosis"
      }
    },
    "proposed_changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/proposedChange"
      }
    },
    "affected_scope": {
      "$ref": "#/$defs/affectedScope"
    },
    "risks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/risk"
      }
    },
    "validation_plan": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/validationStep"
      }
    }
  },
  "$defs": {
    "nonEmptyUniqueStringArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "diagnosis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "issue",
        "specific_reason",
        "evidence_references"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "issue": {
          "type": "string",
          "minLength": 1
        },
        "specific_reason": {
          "type": "string",
          "minLength": 1
        },
        "evidence_references": {
          "$ref": "#/$defs/nonEmptyUniqueStringArray"
        }
      }
    },
    "proposedChange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "addresses_diagnosis_ids",
        "affected_files",
        "justification",
        "behavior_preservation"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "addresses_diagnosis_ids": {
          "$ref": "#/$defs/nonEmptyUniqueStringArray"
        },
        "affected_files": {
          "$ref": "#/$defs/nonEmptyUniqueStringArray"
        },
        "justification": {
          "type": "string",
          "minLength": 1
        },
        "behavior_preservation": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "affectedScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "files",
        "symbols",
        "scope_reason"
      ],
      "properties": {
        "files": {
          "$ref": "#/$defs/nonEmptyUniqueStringArray"
        },
        "symbols": {
          "$ref": "#/$defs/nonEmptyUniqueStringArray"
        },
        "scope_reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "affected_files",
        "mitigation"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "affected_files": {
          "$ref": "#/$defs/nonEmptyUniqueStringArray"
        },
        "mitigation": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "validationStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "check",
        "validates_behavior_ids",
        "validates_change_ids"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "check": {
          "type": "string",
          "minLength": 1
        },
        "validates_behavior_ids": {
          "$ref": "#/$defs/nonEmptyUniqueStringArray"
        },
        "validates_change_ids": {
          "$ref": "#/$defs/nonEmptyUniqueStringArray"
        }
      }
    }
  }
}
