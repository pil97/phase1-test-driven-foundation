{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "refactoring-fixture.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "fixture_id",
    "baseline",
    "requirement",
    "target_scope",
    "context_scope",
    "code_evidence",
    "preserved_behaviors",
    "allowed_scope",
    "forbidden_scope",
    "test_evidence",
    "manual_reference",
    "evaluation_criteria"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "fixture_id": {
      "type": "string",
      "minLength": 1
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "production_state",
        "characterization_test_exists"
      ],
      "properties": {
        "commit": {
          "$ref": "#/$defs/gitHash"
        },
        "production_state": {
          "const": "PRE_MANUAL_REFACTORING_ORIGINAL_IMPLEMENTATION"
        },
        "characterization_test_exists": {
          "const": true
        }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "target_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "purpose",
        "files",
        "symbols"
      ],
      "properties": {
        "purpose": {
          "const": "PRIMARY_CODE_SURFACE_TO_DIAGNOSE"
        },
        "files": {
          "$ref": "#/$defs/nonEmptyUniqueStringArray"
        },
        "symbols": {
          "$ref": "#/$defs/nonEmptyUniqueStringArray"
        }
      }
    },
    "context_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "files",
        "mutation_default",
        "package_wide_mutation_allowed",
        "target_expansion"
      ],
      "properties": {
        "files": {
          "$ref": "#/$defs/nonEmptyUniqueStringArray"
        },
        "mutation_default": {
          "const": "READ_ONLY"
        },
        "package_wide_mutation_allowed": {
          "const": false
        },
        "target_expansion": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "allowed",
            "condition"
          ],
          "properties": {
            "allowed": {
              "const": true
            },
            "condition": {
              "const": "ONLY_IF_STRICTLY_REQUIRED_AND_JUSTIFIED_BY_OBSERVED_CODE"
            }
          }
        }
      }
    },
    "code_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "file",
          "symbol",
          "observed_responsibility",
          "dependency_relation",
          "evidence_reference"
        ],
        "properties": {
          "file": {
            "type": "string",
            "minLength": 1
          },
          "symbol": {
            "type": "string",
            "minLength": 1
          },
          "observed_responsibility": {
            "type": "string",
            "minLength": 1
          },
          "dependency_relation": {
            "type": "string",
            "minLength": 1
          },
          "evidence_reference": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "preserved_behaviors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "preconditions",
          "action",
          "expected_outcomes",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "preconditions": {
            "$ref": "#/$defs/nonEmptyStringArray"
          },
          "action": {
            "type": "string",
            "minLength": 1
          },
          "expected_outcomes": {
            "$ref": "#/$defs/nonEmptyStringArray"
          },
          "evidence": {
            "$ref": "#/$defs/nonEmptyStringArray"
          }
        }
      }
    },
    "allowed_scope": {
      "$ref": "#/$defs/nonEmptyUniqueStringArray"
    },
    "forbidden_scope": {
      "$ref": "#/$defs/nonEmptyUniqueStringArray"
    },
    "test_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_test",
        "baseline_test_blob",
        "manual_end_test_blob",
        "current_test_blob",
        "test_count",
        "baseline_to_manual_end",
        "manual_end_to_current"
      ],
      "properties": {
        "canonical_test": {
          "type": "string",
          "minLength": 1
        },
        "baseline_test_blob": {
          "$ref": "#/$defs/gitHash"
        },
        "manual_end_test_blob": {
          "$ref": "#/$defs/gitHash"
        },
        "current_test_blob": {
          "$ref": "#/$defs/gitHash"
        },
        "test_count": {
          "const": 4
        },
        "baseline_to_manual_end": {
          "const": "UNCHANGED"
        },
        "manual_end_to_current": {
          "const": "UNCHANGED"
        }
      }
    },
    "manual_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_commit",
        "end_commit",
        "commit_count",
        "unrelated_change_count",
        "expose_to_generator",
        "usage",
        "results"
      ],
      "properties": {
        "start_commit": {
          "$ref": "#/$defs/gitHash"
        },
        "end_commit": {
          "$ref": "#/$defs/gitHash"
        },
        "commit_count": {
          "const": 4
        },
        "unrelated_change_count": {
          "const": 0
        },
        "expose_to_generator": {
          "const": false
        },
        "usage": {
          "const": "POST_RUN_COMPARISON_REFERENCE"
        },
        "results": {
          "$ref": "#/$defs/nonEmptyStringArray"
        }
      }
    },
    "evaluation_criteria": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "DIAGNOSIS_ACCURACY",
        "CHANGE_MINIMALITY",
        "BEHAVIOR_PRESERVATION_RISK",
        "TESTABILITY_IMPROVEMENT",
        "EVIDENCE_SUFFICIENCY"
      ],
      "properties": {
        "DIAGNOSIS_ACCURACY": {
          "const": "NUMERIC_AXIS"
        },
        "CHANGE_MINIMALITY": {
          "const": "NUMERIC_AXIS"
        },
        "BEHAVIOR_PRESERVATION_RISK": {
          "const": "NUMERIC_AXIS"
        },
        "TESTABILITY_IMPROVEMENT": {
          "const": "NUMERIC_AXIS"
        },
        "EVIDENCE_SUFFICIENCY": {
          "const": "HARD_GATE"
        }
      }
    }
  },
  "$defs": {
    "gitHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "nonEmptyUniqueStringArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
